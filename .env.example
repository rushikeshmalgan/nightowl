# Copy this file to .env and fill in what you have. Every value is optional.

# Supabase project URL (free plan). Enables the live reader count.
# Leave empty to run in local offline mode.
VITE_SUPABASE_URL=

# Supabase anon (public) key for the project above.
VITE_SUPABASE_ANON_KEY=

# Base URL where lofi.mp3, rain.mp3 and pink.mp3 are hosted (for example a
# Cloudflare R2 bucket with CORS enabled). Leave empty to use the built-in synth.
VITE_AUDIO_CDN_BASE=
